# MT-Billing server configuration
PORT=4000
# Recommended for production, especially multi-instance/load-balanced setups.
# If left unset, the server auto-generates and persists a random secret at
# server/data/.jwt-secret on first boot, so tokens stay valid across restarts
# without needing this set. Generate one with: openssl rand -hex 48
# JWT_SECRET=
# Default admin account created on first run
ADMIN_USER=admin
ADMIN_PASS=admin123
# Public HTTPS origin for subscriber pay links (SMS/email/share). Example:
# PUBLIC_BASE_URL=https://billing.yourisp.com
# Or set the same value in the panel under Payment Links / System Settings.
# PUBLIC_BASE_URL=
# Comma-separated allowlist of origins allowed to call this API from a browser.
# Recommended once you have a fixed public hostname. Left unset, any origin is
# allowed (needed for fresh installs before a hostname is chosen).
# CORS_ORIGIN=https://billing.yourisp.com
# Windows / single-process: serve client/dist from Express (no nginx). Use 1/true.
# SERVE_STATIC=1
# Optional absolute path to the built SPA (defaults to ../client/dist from server).
# STATIC_ROOT=
# Optional absolute path for SQLite + secrets (Windows installer uses ProgramData).
# MT_DATA_DIR=
